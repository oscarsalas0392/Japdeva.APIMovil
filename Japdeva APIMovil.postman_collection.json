        {
          "name": "Autenticar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "const token = jsonData.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token guardado:', token);",
                  "} else {",
                  "    console.warn('No se recibió token en la respuesta');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Correo\": \"oscar.salas03@gmail.com\",\n  \"Contrasena\": \"Osm1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Usuarios/api/Auth/Autenticar",
              "host": ["{{baseUrl}}"],
              "path": ["Usuarios", "api", "Auth", "Autenticar"]
            }
